              <span className="text-sm">{groqStatus?.message || 'Checking connection...'}</span>
            </div>
          </div>

          {/* File Upload */}
          <div className="mb-6">
            <label className="block text-sm font-medium text-gray-700 mb-2">
              Upload LinkedIn Data CSV
            </label>
            <div className="flex items-center gap-4">
              <input
