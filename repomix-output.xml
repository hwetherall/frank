          }
          
          // Continue with the same logic as handleSearch...
          if (expertVectorAvailable) {
            const expertResults = await searchExpertsSemanticly(enhancedQuery, {
              similarityThreshold: 0.6,
              maxResults: 10,
              minExpertScore: 1
            });
            
            results = expertResults.map(expert => ({
              id: expert.id,
              name: expert.name,
