                  >
                    <Sparkles className="h-5 w-5" />
                    <span>Find Expert</span>
                  </button>
                  <button
                    onClick={() => {
                      setSearchQuery('');
                      setSearchResults([]);
                      setHasSearched(false);
                    }}
                    className="w-full px-6 py-2 text-gray-600 hover:text-gray-900 transition-colors"
                  >
                    Clear Search
                  </button>
